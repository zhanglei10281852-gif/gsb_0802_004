{
  "name": "contract-control-center",
  "version": "1.0.0",
  "private": true,
  "description": "Data contract change control center with evidence-based gating",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/bin/server.js",
    "e2e": "npm run build && node dist/bin/e2e-runner.js",
    "dev": "tsx src/bin/server.ts"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^11.3.0",
    "fastify": "^4.28.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
